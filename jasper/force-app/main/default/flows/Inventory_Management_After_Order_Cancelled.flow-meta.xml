    <assignments>
        <name>Assign_the_Product_Item</name>
        <label>Assign the Product Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Product_Item_Of_Current_SC</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_the_Product_Invventory</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Change_the_Consumed_Quantity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Change_the_Consumed_Quantity</name>
        <label>Change the Consumed Quantity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Product_Item_Of_Current_SC.Consumed_Quantity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Calculated_Consumed_Quantity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>List_of_SCs_to_Update</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>List_of_SCs_to_Update</name>
        <label>List of SCs to Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>List_Od_SC</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Product_Item_Of_Current_SC</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Sales_Consumption_Loop</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>If_Order_Cancelled</name>
        <label>If Order Cancelled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Cancelled</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Order Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Order Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Vehicle</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OTC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_all_the_Sales_Consumption_Record</targetReference>
            </connector>
            <label>Yes Cancelled</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Product_Inventory_Found</name>
        <label>If Product Inventory Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Sales_Consumption_Loop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_Product_Invventory</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_the_Product_Item</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Sales_Consumption_Records_are_there</name>
        <label>If Sales Consumption Records are there</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_all_the_Sales_Consumption_Record</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sales_Consumption_Loop</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Calculated_Consumed_Quantity</name>
        <dataType>Number</dataType>
        <expression>{!Get_the_Product_Invventory.Consumed_Quantity__c}-{!Sales_Consumption_Loop.Quantity_Consumed__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Inventory Management After Order Cancelled {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Inventory Management After Order Cancelled</label>
    <loops>
        <name>Sales_Consumption_Loop</name>
        <label>Sales Consumption Loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_all_the_Sales_Consumption_Record</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_the_Product_Invventory</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_the_Inventory</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
