<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PhoneNumberValidation</fullName>
    <active>false</active>
    <errorConditionFormula>NOT( LEN(Phone) &gt;= 10)</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone number must be greater than or equal to 10 digits.</errorMessage>
</ValidationRule>
