<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PS_NAME_CANNOT_BE_BLANK_AND_CHANGE</fullName>
    <active>false</active>
    <errorConditionFormula>AND( NOT(ISBLANK(PS_Name__c)), ISCHANGED(PS_Name__c))</errorConditionFormula>
    <errorDisplayField>PS_Name__c</errorDisplayField>
    <errorMessage>This Field cannot be blank</errorMessage>
</ValidationRule>
