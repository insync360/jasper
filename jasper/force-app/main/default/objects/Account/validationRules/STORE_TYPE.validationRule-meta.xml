<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>STORE_TYPE</fullName>
    <active>false</active>
    <errorConditionFormula>AND( 
   NOT(OR( 
      ISPICKVAL(Type, &quot;Dealer&quot;), 
      ISPICKVAL(Type, &quot;Service Center&quot;) 
   )), 
   NOT(ISPICKVAL(Store_Type__c, &quot;&quot;)) 
)</errorConditionFormula>
    <errorDisplayField>Store_Type__c</errorDisplayField>
    <errorMessage>Please mention store type</errorMessage>
</ValidationRule>
