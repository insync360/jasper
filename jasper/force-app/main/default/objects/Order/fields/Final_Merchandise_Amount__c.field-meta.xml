<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Final_Merchandise_Amount__c</fullName>
    <formula>IF(
   ISBLANK(Total_Merchandise_RollUp__c) || Total_Merchandise_RollUp__c = 0.00,
   0,
   Total_Merchandise_RollUp__c - IF(ISBLANK(Merchandise_Additional_Discount__c), 0, Merchandise_Additional_Discount__c)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Final Merchandise Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
