<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Base_Handling_Charges__c</fullName>
    <formula>IF(
    ISBLANK(Handling_Charges__c) || Handling_Charges__c = 0.00,
    0,
    Handling_Charges__c / 1.18
)</formula>
    <label>Base Handling Charges</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
