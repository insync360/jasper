<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_accessories_Amount__c</fullName>
    <formula>IF(
    ISBLANK(Total_Accessories_RollUp__c) || Total_Accessories_RollUp__c = 0,
    0,
    Total_Accessories_RollUp__c - 
    IF(ISBLANK(Accessories_Discount_Amount__c), 0, Accessories_Discount_Amount__c)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Accessories Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
