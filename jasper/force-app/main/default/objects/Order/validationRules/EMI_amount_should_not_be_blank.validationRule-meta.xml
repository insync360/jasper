<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EMI_amount_should_not_be_blank</fullName>
    <active>true</active>
    <errorConditionFormula>OR(AND(NOT(ISPICKVAL(Finance_Name__c, &apos;&apos;)     ),ISBLANK(EMI_Amount__c)),EMI_Amount__c == 0)</errorConditionFormula>
    <errorMessage>EMI Amount shouldn&apos;r be empty or Zero</errorMessage>
</ValidationRule>
