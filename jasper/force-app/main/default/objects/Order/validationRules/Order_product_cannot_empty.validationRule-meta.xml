<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_product_cannot_empty</fullName>
    <active>false</active>
    <errorConditionFormula>AND(NOT(OR(ISPICKVAL( Status , &quot;Draft&quot;),ISPICKVAL(Status , &quot;Processing&quot;),ISPICKVAL( Status , &quot;Activated&quot;))),( Order_prod_count__c =0), Record_Type_Name__c =&apos;Vehicle&apos;)</errorConditionFormula>
    <errorDisplayField>Accessories_Discount_Amount__c</errorDisplayField>
    <errorMessage>You cannot process without order product</errorMessage>
</ValidationRule>
