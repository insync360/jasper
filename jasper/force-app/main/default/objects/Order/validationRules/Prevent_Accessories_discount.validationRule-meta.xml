<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Accessories_discount</fullName>
    <active>false</active>
    <errorConditionFormula>OR(NOT(ISBLANK( Accessories_Discount_Amount__c )), NOT(Accessories_Discount_Amount__c == 0))</errorConditionFormula>
    <errorDisplayField>Accessories_Discount_Amount__c</errorDisplayField>
    <errorMessage>Accessories Discount is not allowed</errorMessage>
</ValidationRule>
