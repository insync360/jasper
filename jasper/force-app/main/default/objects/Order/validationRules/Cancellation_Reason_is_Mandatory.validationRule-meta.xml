<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancellation_Reason_is_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Order Cancelled&quot;),
    ISCHANGED(Status),
    ISBLANK(Reason_for_Cancellation__c)
)</errorConditionFormula>
    <errorMessage>Reason for cancellation is mandatory</errorMessage>
</ValidationRule>
