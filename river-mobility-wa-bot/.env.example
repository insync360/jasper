# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=                 # System User permanent access token
WHATSAPP_PHONE_NUMBER_ID=1108168065719952
WHATSAPP_WABA_ID=1239087798139137
WHATSAPP_APP_SECRET=            # App > Settings > Basic > App Secret (for webhook signature)
WEBHOOK_VERIFY_TOKEN=          # any string you choose; paste the same in Meta webhook config
GRAPH_VERSION=v21.0

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Salesforce (rrdev sandbox) ---
# Pick ONE auth mode:
SF_LOGIN_URL=https://test.salesforce.com
SF_INSTANCE_URL=https://rivermobilityprivatelimited2--rrdev.sandbox.my.salesforce.com
# Mode 1 (durable): refresh token + connected-app client id
SF_REFRESH_TOKEN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Mode 2: username / password (password + security token)
SF_USERNAME=
SF_PASSWORD=
# Mode 3 (local test only): short-lived access token
SF_ACCESS_TOKEN=

# --- Runtime ---
NODE_ENV=production
